@model MerceariaMVCLm.Models.Cliente

@{
    ViewData["Title"] = "Excluir Cliente";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold">
                    <i class="bi bi-exclamation-triangle me-2"></i>Excluir Cliente
                </h4>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">Tem certeza de que deseja excluir este cliente?</p>
                <hr />
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Nome)</dt>
                    <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Nome)</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Idade)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Idade) anos</dd>

                    <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(model => model.Ativo)</dt>
                    <dd class="col-sm-8">
                        @if (Model.Ativo)
                        {
                            <span class="badge bg-success-subtle text-success border border-success">Ativo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary">Inativo</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer bg-light p-3">
                <form asp-action="Delete" class="d-flex justify-content-between m-0">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>Confirmar Exclusão
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>